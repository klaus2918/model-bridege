{
  "_doc": "Model-Gate 进阶配置模板（本文件已随安装包放在安装目录）。当前生效的配置是同目录的 bridge.config.json；本文件只作参考：想接入更多上游（付费 / 免密 / 本机代理）时，照抄这里的条目到 bridge.config.json 里再改，改前先备份。安装器不会覆盖已存在的 bridge.config.json，升级与静默更新同样不覆盖。切勿把明文 apiKey 写进配置——请用 apiKeyEnv 引用环境变量。",
  "_keys": "密钥只从环境变量或你显式指定的凭据文件读取：apiKeyEnv 指定变量名，值由面板「写入密钥」写入（目标二选一：写入用户环境变量 → HKCU\\Environment；写入你手动指定的文件 → 该文件路径），也可由外部进程注入；JSON 里的明文 apiKey 会被忽略并给出迁移提示。apiKeyFile / apiKeyAgentPath 仅在你自己显式填写路径时读取（无内置默认路径），配置文件里只保存路径引用，不保存密钥。",
  "_models": "各上游的 models 是该上游可用模型的声明（也是按名路由的依据）。可以在面板上点「查询清单」按上游拉取并勾选写入，不用手打：面板按 OpenAI 兼容约定拉 GET {baseUrl}/v1/models（路径可用 compat.endpoint.models 改）。",
  "_freeSources": "免费来源：zen 与 kilo 两条免密通道，无需账号与 API Key（zen 用匿名 Bearer public + 客户端指纹，kilo 完全不发送鉴权头）。面板「免费来源」页可一键接入与实测可用性。注意：免费模型只登记在各自上游的 models 里，不会自动进入顶层 models（顶层 models 非空时全局清单只按白名单展示）——需要对外暴露时在模型卡上点「加入全局清单」。",
  "port": 8900,
  "host": "127.0.0.1",
  "defaultModel": "deepseek-flash",
  "models": [
    "deepseek-flash",
    "mimo-v2.5-pro",
    "glm5.3",
    "minimax/minimax-m3.1-flash:free"
  ],
  "maxTokens": 8192,
  "timeoutSeconds": 600,
  "accessLog": true,
  "modelsCacheSeconds": 300,
  "aliases": {},
  "thinking": {
    "passthrough": true,
    "cacheSize": 500
  },
  "tools": {
    "downgradeForcedChoice": true
  },
  "upstreams": {
    "cch": {
      "protocol": "anthropic",
      "baseUrl": "http://127.0.0.1:15721",
      "anthropicVersion": "2023-06-01",
      "default": true,
      "fetchModels": false,
      "autoModels": false,
      "compat": {
        "thinking": {
          "passthrough": true
        }
      },
      "models": [
        "deepseek-flash",
        "mimo-v2.5-pro",
        "glm5.3"
      ]
    },
    "go": {
      "protocol": "openai",
      "baseUrl": "https://opencode.ai/zen/go/v1",
      "apiKeyEnv": "OPENCODE_API_KEY",
      "sessionHeader": true,
      "models": [
        "glm-5.3-flash",
        "deepseek-v4.1-flash",
        "mimo-v2.6-flash",
        "longcat-2.5-preview-free",
        "step-5-preview-free"
      ]
    },
    "zen": {
      "protocol": "openai",
      "transport": "opencode",
      "baseUrl": "https://opencode.ai/zen/v1",
      "fetchModels": false,
      "autoModels": false,
      "sessionHeader": false,
      "models": [
        "mimo-v2.6-flash-free",
        "big-pickle"
      ]
    },
    "commandcode": {
      "protocol": "commandcode",
      "baseUrl": "https://api.commandcode.ai",
      "apiKeyEnv": "COMMAND_CODE_API_KEY",
      "cliVersion": "auto",
      "cliEnvironment": "production",
      "modelCatalog": "auto",
      "modelCatalogPlan": "auto",
      "pauseTurn": true,
      "cmdZdr": true,
      "fetchModels": false,
      "compat": {
        "limits": {
          "maxOutputTokens": 64000
        },
        "zdr": true
      },
      "models": [
        "deepseek/deepseek-v4.1-flash",
        "deepseek/deepseek-v4-pro",
        "deepseek/deepseek-v4-flash",
        "moonshotai/Kimi-K3",
        "zai-org/GLM-5.3",
        "MiniMaxAI/MiniMax-M3",
        "xiaomi/mimo-v2.5-pro"
      ]
    },
    "kilo": {
      "protocol": "openai",
      "baseUrl": "https://api.kilo.ai/api/openrouter",
      "fetchModels": true,
      "autoModels": false,
      "default": false,
      "compat": {
        "auth": {
          "scheme": "none"
        },
        "endpoint": {
          "chat": "/v1/chat/completions",
          "models": "/v1/models"
        },
        "session": {
          "header": "x-kilocode-taskid",
          "idStyle": "sess16"
        },
        "headers": {
          "HTTP-Referer": "https://kilocode.ai",
          "X-Title": "Kilo Code",
          "User-Agent": "opencode-kilo-provider/7.8.15",
          "X-KILOCODE-EDITORNAME": "Kilo CLI 7.8.15",
          "x-kilocode-mode": "code"
        }
      },
      "models": [
        "minimax/minimax-m3.1-flash:free",
        "poolside/laguna-s-2.1:free",
        "cohere/north-mini-code:free",
        "nvidia/nemotron-3-ultra-550b-a55b:free",
        "openrouter/free"
      ]
    }
  }
}
