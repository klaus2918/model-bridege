# ── 凭据与本地配置（禁止入库）──────────────────────────────
# 真实配置含本机路径与密钥引用；只提交 bridge.config.example.json 模板
/bridge.config.json
.env
.env.*
*.env
.jcode/
**/auth.json
**/credentials*.json
*.key
*.pem
*.token
.sensitive-terms

# ── 运行数据与构建产物 ─────────────────────────────────────
/dist/
/data/
/SHA256SUMS

# ── 变更工作区与过程文件 ───────────────────────────────────
# .op 含本机绝对路径与源码证据片段
.op/
_tmp_*
/run-*/
/e2e.config.json
*.out
*.err
probe.out
probe.err
coldstart.out
coldstart.err
gui.out
gui.err
_secret_selftest.tmp

# ── 通用忽略 ───────────────────────────────────────────────
# 系统
.DS_Store
Thumbs.db
desktop.ini

# 编辑器/IDE
.idea/
.vscode/
*.swp
*.swo

# 日志与备份
*.log
*.bak
*.backup
*.bak-*

# 文档配图视频：体积大且可由 live-panel 重新生成，只留 HTML 与静态帧
docs/live-panel/*.mp4

# ── Rust 构建产物 ──────────────────────────────────────────
rust/**/target/
target/
