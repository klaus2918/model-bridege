  "profiles": {
    "openai": {
      "label": "OpenAI 兼容",
      "description": "通用 OpenAI Chat Completions 端点；Bearer 鉴权、无会话头。",
      "priority": 10,
      "protocols": [
        "openai"
      ],
      "detect": {
        "baseUrlContains": []
      },
      "compat": {
        "auth": {
          "scheme": "bearer",
          "header": "authorization",
          "prefix": "Bearer "
        },
        "session": {
          "header": "",
          "idStyle": "hex32"
        },
        "headers": {},
        "endpoint": {
          "chat": "/v1/chat/completions",
          "models": "/v1/models"
        },
        "thinking": {
          "passthrough": false,
          "field": "reasoning_content"
        },
        "toolChoice": {
          "downgradeForced": false
        },
        "limits": {},
        "zdr": false,
        "versionHeader": "",
        "environmentHeader": "",
        "catalog": {
          "source": "endpoint",
          "path": "/v1/models",
          "plan": false
        },
        "capabilities": {
          "stream": true,
          "tools": true,
          "vision": false,
          "thinking": false,
          "cache": false,
          "systemPrompt": true
        }
      },
      "defaults": {
        "fetchModels": true,
        "autoModels": false,
        "pauseTurn": false
      }
    },
    "opencode": {
      "label": "opencode / zen",
